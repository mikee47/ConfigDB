{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "title": "request",
      "properties": {
        "method": {
          "type": "string",
          "default": "query"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "all"
          ]
        }
      }
    },
    {
      "type": "object",
      "title": "response",
      "properties": {
        "code": {
          "type": "integer",
          "default": -1
        },
        "message": {
          "type": "string",
          "default": "undefined"
        }
      }
    }
  ]
}