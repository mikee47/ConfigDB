{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "string-value": {
      "type": "string"
    },
    "boolean-value": {
      "type": "boolean"
    },
    "integer-value": {
      "type": "integer"
    },
    "non-negative-integer": {
      "type": "integer",
      "minimum": 0
    },
    "raw-value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023
    },
    "hue-value": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "percentage-value": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "jsonrpc-version": {
      "type": "string",
      "const": "2.0",
      "default": "2.0"
    },
    "jsonrpc-id": {
      "type": "integer"
    },
    "error-code": {
      "type": "integer"
    },
    "color-method": {
      "type": "string",
      "const": "color"
    },
    "info-method": {
      "type": "string",
      "const": "info"
    }
  }
}
