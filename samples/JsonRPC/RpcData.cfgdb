{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "color_event": {
      "type": "object",
      "store": true,
      "oneOf": [
        {
          "type": "object",
          "title": "raw",
          "properties": {
            "r": {
              "$ref": "#/$defs/color-value"
            },
            "g": {
              "$ref": "#/$defs/color-value"
            },
            "b": {
              "$ref": "#/$defs/color-value"
            },
            "ww": {
              "$ref": "#/$defs/color-value"
            },
            "cw": {
              "$ref": "#/$defs/color-value"
            }
          }
        },
        {
          "type": "object",
          "title": "hsv",
          "properties": {
            "h": {
              "$ref": "#/$defs/color-value"
            },
            "s": {
              "$ref": "#/$defs/color-value"
            },
            "v": {
              "$ref": "#/$defs/color-value"
            },
            "ct": {
              "$ref": "#/$defs/color-value"
            }
          }
        }
      ]
    },
    "result": {
      "$ref": "#/$defs/standard-result"
    },
    "error": {
      "$ref": "#/$defs/standard-error"
    }
  },
  "$defs": {
    "color-value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "standard-result": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      }
    },
    "standard-error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "message": {
          "type": "string"
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "title": "none"
            },
            {
              "type": "object",
              "title": "position",
              "properties": {
                "location": {
                  "type": "integer"
                },
                "length": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      }
    }
  }
}